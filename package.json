{
  "name": "agentic-design-system",
  "version": "0.0.0",
  "private": true,
  "description": "A design system template an agent can build in and keep honest: DTCG tokens, component contracts, Storybook, and the design-delta gate.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chrisgriffin/agentic-design-system.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:tokens": "node tokens/scripts/build-css.mjs",
    "prettier:check": "prettier --check .",
    "prettier:format": "prettier --write .",
    "lint": "eslint .",
    "lint:styles": "stylelint \"**/*.css\" --allow-empty-input",
    "typecheck": "tsc --noEmit",
    "scaffold": "node scripts/scaffold-component.mjs",
    "test": "node --test tokens/scripts/*.test.mjs && vitest run",
    "verify": "npm run build:tokens && npm run typecheck && npm run prettier:check && npm run lint && npm run lint:styles && npm run drift:verify && npm test",
    "drift:audit": "design-delta audit",
    "drift:contracts": "design-delta contracts",
    "drift:lint": "design-delta lint",
    "drift:scaffold": "design-delta scaffold",
    "drift:verify": "design-delta verify",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "prettier": "@chrisgriffin/config/prettier",
  "devDependencies": {
    "@chrisgriffin/config": "github:chrisgriffin/config#v1",
    "@figma/code-connect": "^2.1.0",
    "@storybook/addon-a11y": "^10.6.6",
    "@storybook/addon-docs": "^10.6.6",
    "@storybook/addon-themes": "^10.6.6",
    "@storybook/react-vite": "^10.6.6",
    "@terrazzo/parser": "^2.10.0",
    "@terrazzo/plugin-css": "^2.10.0",
    "@terrazzo/token-tools": "^2.10.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "design-delta": "^0.27.0",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.6",
    "stylelint": "^17.12.0",
    "stylelint-config-css-modules": "^4.6.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-declaration-strict-value": "^1.12.1",
    "stylelint-value-no-unknown-custom-properties": "^6.1.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
