      "type": "container",
      "element": "div",
      "codeClass": "card",
      "content": {
        "$prop": "children"
      }
    }
  },
  "styles": {
    "root": {
      "base": {
        "borderRadius": {
          "token": "radius.lg"
        },
        "background": {
          "token": "color.bg.surface-raised"
        },
        "color": {
          "token": "color.fg.default"
        },
        "padding": {
          "all": {
            "token": "inset.lg"
          }
        },
        "border": {
          "width": {
            "token": "border.default"
          },
          "color": {
            "token": "color.border.default"
          }
        },
        "fontFamily": {
          "token": "font-family.body"
        },
        "fontSize": {
          "token": "font-size.md"
        },
        "lineHeight": {
          "token": "line-height.body"
        }
      },
      "variants": [
        {
          "when": {
            "padding": "none"
          },
          "padding": {
            "all": "raw(0)"
          }
        }
      ]
    }
  }
