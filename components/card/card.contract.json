{
  "$schema": "../../node_modules/design-delta/schema/contract.schema.json",
  "id": "card",
  "title": "Card",
  "status": "published",
  "sources": {
    "code": {
      "path": "components/card/card.tsx",
      "styles": "components/card/card.module.css"
    }
  },
  "props": {
    "children": {
      "type": "slot",
      "_comment": "React's implicit children slot; a design tool exposes it as a named slot property."
    },
