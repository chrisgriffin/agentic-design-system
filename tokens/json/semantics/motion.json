{
  "duration": {
    "fast": {
      "$type": "duration",
      "$value": "{duration.100}"
    },
    "base": {
      "$type": "duration",
      "$value": "{duration.200}"
    },
    "slow": {
      "$type": "duration",
      "$value": "{duration.300}"
    }
  },
  "easing": {
    "standard": {
      "$type": "cubicBezier",
      "$value": "{curve.standard}"
    },
    "enter": {
      "$type": "cubicBezier",
      "$value": "{curve.enter}"
    },
    "exit": {
      "$type": "cubicBezier",
      "$value": "{curve.exit}"
    }
  }
}
